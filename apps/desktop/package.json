{
  "name": "@oil-agency/desktop",
  "productName": "Oil Agency POS",
  "description": "Offline sales, inventory, purchases, and khata management for an oil and ghee agency.",
  "author": "Umar Malik (www.umarmalikd-dev.com)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.umarmalik.oil-agency-pos",
    "win": {
      "icon": "public/app-icon.ico"
    }
  },
  "scripts": {
    "predev": "npm --prefix ../.. run db:generate && npm --prefix ../.. run db:ensure",
    "dev": "vite",
    "build": "npm --prefix ../.. run db:generate && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@oil-agency/api": "*",
    "@oil-agency/shared": "*",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.28",
    "write-excel-file": "^2.3.10",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "electron": "^36.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
